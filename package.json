{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "nx run-many -t dev -t serve -p @org/web @org/api ai-orchestrator job-agent apply-agent outreach-agent",
    "dev:web": "nx dev @org/web",
    "dev:api": "NODE_V8_COVERAGE=$PWD/.fallow/v8-coverage nx serve @org/api",
    "dev:ai-orchestrator": "nx serve ai-orchestrator",
    "dev:job-agent": "nx serve job-agent",
    "dev:apply-agent": "nx serve apply-agent",
    "dev:outreach-agent": "nx serve outreach-agent",
    "build:web": "nx build @org/web",
    "build:api": "nx build @org/api",
    "build:apps": "nx run-many -t build -p @org/web,@org/api",
    "job-agent:sync": "nx run job-agent:sync",
    "job-agent:test": "nx run job-agent:test",
    "job-agent:seed-yc": "nx run job-agent:seed-yc",
    "test": "python3 tests/run.py all",
    "test:job-agent": "python3 tests/run.py job-agent",
    "test:ai-orchestrator": "python3 tests/run.py ai-orchestrator",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/esbuild": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/js": "^22.7.5",
    "@nx/next": "^22.7.5",
    "@nx/node": "^22.7.5",
    "@nx/react": "^22.7.5",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/express": "^4.17.21",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.13",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "fallow": "^2.96.0",
    "nx": "22.7.5",
    "postcss": "8.4.38",
    "prettier": "^3.8.1",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
