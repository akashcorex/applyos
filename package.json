{
  "name": "applyso",
  "version": "0.0.0",
  "private": true,
  "description": "applyso — an AI application agent that discovers and applies to jobs on your behalf. Monorepo housing the Next.js web app, API server, and Python agent services.",
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev serve --filter=@applyso/web --filter=@applyso/api --filter=ai-orchestrator --filter=job-agent --filter=apply-agent --filter=outreach-agent --filter=resume-agent",
    "dev:web": "turbo run dev --filter=@applyso/web",
    "dev:api": "NODE_V8_COVERAGE=$PWD/.fallow/v8-coverage turbo run serve --filter=@applyso/api",
    "dev:agents": "turbo run serve --filter=ai-orchestrator --filter=job-agent --filter=apply-agent --filter=outreach-agent --filter=resume-agent",
    "dev:ai-orchestrator": "turbo run serve --filter=ai-orchestrator",
    "dev:job-agent": "turbo run serve --filter=job-agent",
    "dev:apply-agent": "turbo run serve --filter=apply-agent",
    "dev:outreach-agent": "turbo run serve --filter=outreach-agent",
    "dev:resume-agent": "turbo run serve --filter=resume-agent",
    "build": "turbo run build",
    "build:web": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/outreach} turbo run build --filter=@applyso/web",
    "build:api": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/outreach} turbo run build --filter=@applyso/api",
    "build:apps": "turbo run build --filter=@applyso/web --filter=@applyso/api",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/outreach} turbo run generate --filter=@applyso/database",
    "db:migrate": "turbo run migrate --filter=@applyso/database",
    "db:push": "turbo run push --filter=@applyso/database",
    "db:studio": "turbo run studio --filter=@applyso/database",
    "billing:preflight": "bun scripts/dodo-preflight.ts",
    "sync:agents": "turbo run sync --filter=ai-orchestrator --filter=job-agent --filter=apply-agent --filter=outreach-agent --filter=resume-agent",
    "sync:job-agent": "turbo run sync --filter=job-agent",
    "sync:resume-agent": "turbo run sync --filter=resume-agent",
    "seed:yc": "turbo run seed-yc --filter=job-agent",
    "test": "python3 tests/run.py all",
    "test:job-agent": "python3 tests/run.py job-agent",
    "test:ai-orchestrator": "python3 tests/run.py ai-orchestrator",
    "test:resume-agent": "python3 tests/run.py resume-agent",
    "test:outreach-agent": "python3 tests/run.py outreach-agent",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b && tsc --noEmit -p apps/api/tsconfig.app.json && tsc --noEmit -p packages/validation/tsconfig.json && tsc --noEmit -p packages/analytics/tsconfig.json",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "start": "node scripts/railway-start.mjs"
  },
  "dependencies": {
    "next": "~16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/express": "^4.17.21",
    "@types/node": "20.19.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "10.5.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "fallow": "^2.96.0",
    "globals": "^16.4.0",
    "happy-dom": "^20.14.5",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "turbo": "^2.10.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
