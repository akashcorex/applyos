# Fallow runtime coverage (server-side only — never commit real keys)
BEACON_API_KEY=
FALLOW_PROJECT_ID=akashcorex/outreach-autometer
FALLOW_BEACON_ENDPOINT=https://api.fallow.cloud
GIT_SHA=

# NODE_V8_COVERAGE must be set before Node starts (see bun run dev:api).

# Auth + database
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
