{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.json"],
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["EARLY_ACCESS_MODE", "DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "serve": {
      "dependsOn": ["^build", "sync"],
      "cache": false,
      "persistent": true
    },
    "worker": {
      "cache": false,
      "persistent": true
    },
    "sync": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "seed-yc": {
      "dependsOn": ["sync"],
      "cache": false
    },
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "push": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
