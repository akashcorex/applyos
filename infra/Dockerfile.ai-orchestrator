# syntax=docker/dockerfile:1
# Railway Dockerfile for ai-orchestrator (FastAPI, Python 3.12, uv)
# Build context: repo root
# Set Dockerfile Path = infra/Dockerfile.ai-orchestrator

FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_SYSTEM_PYTHON=1

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /usr/local/bin/uv

# Cache deps
COPY apps/ai-orchestrator/pyproject.toml apps/ai-orchestrator/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Copy source
COPY apps/ai-orchestrator ./

RUN uv sync --frozen --no-dev

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD curl -f http://localhost:${PORT:-8001}/health || exit 1
CMD ["sh", "-c", "uv run uvicorn main:app --host 0.0.0.0 --port ${PORT:-8001}"]
