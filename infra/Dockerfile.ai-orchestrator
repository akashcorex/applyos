# syntax=docker/dockerfile:1
# ai-orchestrator — uv build, venv-only runner (no uv/curl in the final image).
# Build context: repo root. Dockerfile Path = infra/Dockerfile.ai-orchestrator

FROM ghcr.io/astral-sh/uv:0.7.13 AS uv

FROM python:3.12-slim AS builder
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_SYSTEM_PYTHON=1 \
    UV_NO_DEV=1
COPY --from=uv /uv /usr/local/bin/uv

COPY apps/ai-orchestrator/pyproject.toml apps/ai-orchestrator/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY apps/ai-orchestrator ./
RUN uv sync --frozen --no-dev \
 && find /app/.venv -type f -name '*.pyc' -delete

FROM python:3.12-slim AS runner
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

RUN adduser --system --group --uid 1001 appuser
COPY --from=builder --chown=appuser:appuser /app /app
USER appuser

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8001')+'/health')"
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8001}"]
