# syntax=docker/dockerfile:1
# Railway Dockerfile for job-agent (FastAPI, Playwright)
# Build context: repo root
# Set Dockerfile Path = infra/Dockerfile.job-agent

FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_SYSTEM_PYTHON=1

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /usr/local/bin/uv

COPY apps/job-agent/pyproject.toml apps/job-agent/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY apps/job-agent ./
RUN uv sync --frozen --no-dev

# Playwright browsers (needed for ATS scraping)
RUN uv run playwright install --with-deps chromium || true

EXPOSE 8002
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl -f http://localhost:${PORT:-8002}/health || exit 1
CMD ["sh", "-c", "uv run uvicorn main:app --host 0.0.0.0 --port ${PORT:-8002}"]
