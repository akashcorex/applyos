# syntax=docker/dockerfile:1
# job-agent: uv build + Chromium, slim runner.

FROM ghcr.io/astral-sh/uv:0.7.13 AS uv

FROM python:3.12-slim AS builder
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_SYSTEM_PYTHON=1 \
    UV_NO_DEV=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY --from=uv /uv /usr/local/bin/uv

COPY apps/job-agent/pyproject.toml apps/job-agent/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY apps/job-agent ./
RUN uv sync --frozen --no-dev \
 && /app/.venv/bin/playwright install chromium \
 && find /app/.venv -type f -name '*.pyc' -delete

FROM python:3.12-slim AS runner
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY --from=builder /app /app
COPY --from=builder /ms-playwright /ms-playwright

RUN /app/.venv/bin/playwright install-deps chromium \
 && rm -rf /var/lib/apt/lists/* /root/.cache

EXPOSE 8002
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8002')+'/health')"
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8002}"]
