# syntax=docker/dockerfile:1
# Railway Dockerfile for Next.js web (Turborepo + Bun)
# Build context: repo root (Railway Root Directory = /)
# Set Dockerfile Path = infra/Dockerfile.web in Railway dashboard

FROM oven/bun:1.4.1 AS base
WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package.json bun.lock turbo.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/ai-orchestrator/package.json ./apps/ai-orchestrator/package.json
COPY apps/job-agent/package.json ./apps/job-agent/package.json
COPY apps/apply-agent/package.json ./apps/apply-agent/package.json
COPY apps/outreach-agent/package.json ./apps/outreach-agent/package.json
COPY apps/resume-agent/package.json ./apps/resume-agent/package.json
COPY apps/web ./apps/web

RUN bun install --frozen-lockfile

ENV NEXT_TELEMETRY_DISABLED=1
# Uncomment to use standalone output (requires NEXT_STANDALONE=true in next.config.js:9)
# ENV NEXT_STANDALONE=true
RUN bun run build:web

FROM oven/bun:1.4.1 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0

COPY --from=base /app/package.json ./package.json
COPY --from=base /app/bun.lock ./bun.lock
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/packages ./packages
COPY --from=base /app/apps/web ./apps/web
COPY --from=base /app/turbo.json ./turbo.json
COPY --from=base /app/tsconfig.base.json ./tsconfig.base.json
COPY --from=base /app/tsconfig.json ./tsconfig.json

EXPOSE 3000
# Railway injects PORT; next start handles PORT + HOSTNAME via apps/web/package.json:8
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD bun --filter @applyso/web exec -- curl -f http://localhost:${PORT:-3000}/ || exit 1
CMD ["sh", "-c", "bun --filter @applyso/web start"]
