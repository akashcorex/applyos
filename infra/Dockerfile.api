# syntax=docker/dockerfile:1
# API: filtered install → generate → production prune → node slim + migrate on start.

FROM oven/bun:1.4.1 AS deps
WORKDIR /app

COPY package.json bun.lock turbo.json tsconfig.base.json tsconfig.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/ai-orchestrator/package.json ./apps/ai-orchestrator/package.json
COPY apps/job-agent/package.json ./apps/job-agent/package.json
COPY apps/apply-agent/package.json ./apps/apply-agent/package.json
COPY apps/outreach-agent/package.json ./apps/outreach-agent/package.json
COPY apps/resume-agent/package.json ./apps/resume-agent/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/validation/package.json ./packages/validation/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/analytics/package.json ./packages/analytics/package.json
COPY packages/queue/package.json ./packages/queue/package.json
COPY packages/logger/package.json ./packages/logger/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/sdk/package.json ./packages/sdk/package.json

RUN bun install --frozen-lockfile \
    --filter=@applyso/api \
    --filter=@applyso/database \
    --filter=@applyso/validation

FROM deps AS build
COPY packages/database ./packages/database
COPY packages/validation ./packages/validation
COPY apps/api ./apps/api

ENV DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/outreach
RUN bun run --filter=@applyso/database generate \
 && bun run --filter=@applyso/api build:production

RUN bun install --frozen-lockfile --production \
    --filter=@applyso/api \
    --filter=@applyso/database \
    --filter=@applyso/validation \
 && rm -rf \
    node_modules/next \
    node_modules/react \
    node_modules/react-dom \
    node_modules/@next \
    node_modules/.cache \
    apps/api/src \
    apps/api/tsconfig.json \
    apps/api/tsconfig.app.json \
    apps/api/scripts/build.mjs

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && adduser --system --group --uid 1001 api

COPY --from=build --chown=api:api /app/package.json ./package.json
COPY --from=build --chown=api:api /app/node_modules ./node_modules
COPY --from=build --chown=api:api /app/packages/database ./packages/database
COPY --from=build --chown=api:api /app/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=api:api /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=api:api /app/apps/api/scripts/start.sh ./apps/api/scripts/start.sh

RUN chmod +x /app/apps/api/scripts/start.sh \
 && mkdir -p /app/uploads \
 && chown api:api /app/uploads

USER api
EXPOSE 3333
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3333)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["/app/apps/api/scripts/start.sh"]
