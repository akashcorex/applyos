# syntax=docker/dockerfile:1
# Railway Dockerfile for Express API (Turborepo + Bun + esbuild)
# Build context: repo root
# Set Dockerfile Path = infra/Dockerfile.api

FROM oven/bun:1.4.1 AS base
WORKDIR /app

COPY package.json bun.lock turbo.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/ai-orchestrator/package.json ./apps/ai-orchestrator/package.json
COPY apps/job-agent/package.json ./apps/job-agent/package.json
COPY apps/apply-agent/package.json ./apps/apply-agent/package.json
COPY apps/outreach-agent/package.json ./apps/outreach-agent/package.json
COPY apps/resume-agent/package.json ./apps/resume-agent/package.json
COPY apps/api ./apps/api

RUN bun install --frozen-lockfile
# Prisma client is gitignored; generate it before the API bundle imports it.
RUN bun run db:generate
RUN bun run build:api

FROM oven/bun:1.4.1 AS runner
WORKDIR /app
ENV NODE_ENV=production
# HOST=0.0.0.0 is now default in apps/api/src/main.ts:16, PORT injected by Railway

COPY --from=base /app/package.json ./package.json
COPY --from=base /app/bun.lock ./bun.lock
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/packages ./packages
COPY --from=base /app/apps/api ./apps/api

EXPOSE 3333
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://localhost:'+(process.env.PORT||3333)+'/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/main.js"]
