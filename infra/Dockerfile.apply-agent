# syntax=docker/dockerfile:1
# apply-agent: venv + Chromium in builder, slim runner.

FROM python:3.12-slim AS builder
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN python -m venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

COPY apps/apply-agent/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY apps/apply-agent ./
RUN playwright install chromium \
 && find /app/.venv -type f -name '*.pyc' -delete

FROM python:3.12-slim AS runner
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY --from=builder /app /app
COPY --from=builder /ms-playwright /ms-playwright

RUN playwright install-deps chromium \
 && mkdir -p /tmp/applyos-artifacts \
 && rm -rf /var/lib/apt/lists/* /root/.cache

EXPOSE 8003
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8003')+'/health')"
CMD ["sh", "-c", "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8003}"]
