# Railway + Vercel env template
# Web runs on Vercel. API + agents run on Railway.
# Shared secrets must be IDENTICAL across Vercel, api, orchestrator, apply-agent, resume-agent.

# === Shared (Railway services + Vercel) ===
AGENT_SERVICE_TOKEN= # openssl rand -hex 32
DATABASE_URL= # ${{Postgres.DATABASE_URL}} on Railway; same Neon/Railway URL on Vercel
REDIS_URL= # ${{Redis.REDIS_URL}} or redis://redis.railway.internal:6379/0

# === api (Railway public + *.railway.internal) ===
HOST=0.0.0.0
# Railway injects PORT at runtime; do not hardcode it in the service.
BETTER_AUTH_SECRET= # openssl rand -base64 32
BETTER_AUTH_URL=https://api.yourdomain.up.railway.app
WEB_URL=https://www.applyos.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
BEACON_API_KEY=
FALLOW_PROJECT_ID=akashcorex/applyos

# Dodo Payments (test mode first — create 9 recurring products + add-on packs in the dashboard)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test
DODO_PRODUCT_STARTER_MONTHLY=pdt_
DODO_PRODUCT_STARTER_QUARTERLY=pdt_
DODO_PRODUCT_STARTER_ANNUAL=pdt_
DODO_PRODUCT_PRO_MONTHLY=pdt_
DODO_PRODUCT_PRO_QUARTERLY=pdt_
DODO_PRODUCT_PRO_ANNUAL=pdt_
DODO_PRODUCT_POWER_MONTHLY=pdt_
DODO_PRODUCT_POWER_QUARTERLY=pdt_
DODO_PRODUCT_POWER_ANNUAL=pdt_
DODO_PRODUCT_ADDON_PLUS_50=pdt_
DODO_PRODUCT_ADDON_PLUS_150=pdt_

# === web (set these on Vercel, Production + Preview) ===
NEXT_PUBLIC_API_URL=https://api.yourdomain.up.railway.app
NEXT_PUBLIC_WEB_URL=https://www.applyos.in
NEXT_PUBLIC_SITE_URL=https://www.applyos.in
API_URL=https://api.yourdomain.up.railway.app
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# === ai-orchestrator ===
JOB_AGENT_URL=http://job-agent.railway.internal:8002
APPLY_AGENT_URL=http://apply-agent.railway.internal:8003
RESUME_AGENT_URL=http://resume-agent.railway.internal:8005
API_URL=http://api.railway.internal:3333
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# === job-agent ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# === apply-agent ===
ANTHROPIC_API_KEY=
API_URL=http://api.railway.internal:3333
RESUME_AGENT_URL=http://resume-agent.railway.internal:8005
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=capsolver
CAPTCHA_SOLVER_ENABLED=false

# === resume-agent (Chroma Cloud primary, PGVector fallback) ===
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key # only needed if EMBEDDING_PROVIDER=openai fallback; not needed for Chroma Qwen/Splade
DATABASE_URL=${{Postgres.DATABASE_URL}} # still needed for resumes, IR, variants, artifacts
# Chroma Cloud — get from dashboard: https://www.trychroma.com/<your-org>/<your-region>/<your-db>/sdk?tab=env
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your-chroma-api-key # required for Chroma Qwen/Splade
CHROMA_TENANT=your-chroma-tenant-id
CHROMA_DATABASE=your-chroma-database
CHROMA_COLLECTION_PREFIX=resumes
CHROMA_SHARD_BY_USER=true
CHROMA_SPARSE_ENABLED=true

# === outreach-agent ===
ANTHROPIC_API_KEY=
API_URL=http://api.railway.internal:3333
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
EMAIL_FROM=
