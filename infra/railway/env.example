# Railway env template — copy to each service's Variables tab
# Shared secrets must be IDENTICAL across web, api, orchestrator, apply-agent, resume-agent

# === Shared (all services) ===
AGENT_SERVICE_TOKEN= # openssl rand -hex 32
DATABASE_URL= # set automatically by Railway Postgres: ${{Postgres.DATABASE_URL}}
REDIS_URL= # ${{Redis.REDIS_URL}} or redis://redis.railway.internal:6379/0

# === api ===
HOST=0.0.0.0
PORT=3333 # Railway injects; leave as $PORT at runtime, value here is fallback
BETTER_AUTH_SECRET= # openssl rand -base64 32
BETTER_AUTH_URL=https://api.yourdomain.up.railway.app
WEB_URL=https://web.yourdomain.up.railway.app
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
BEACON_API_KEY=
FALLOW_PROJECT_ID=akashcorex/outreach-autometer

# === web ===
NEXT_PUBLIC_API_URL=https://api.yourdomain.up.railway.app
API_URL=http://api.railway.internal:3333
EARLY_ACCESS_MODE=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# === ai-orchestrator ===
JOB_AGENT_URL=http://job-agent.railway.internal:8002
APPLY_AGENT_URL=http://apply-agent.railway.internal:8003
RESUME_AGENT_URL=http://resume-agent.railway.internal:8005
API_URL=http://api.railway.internal:3333
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# === job-agent ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# === apply-agent ===
ANTHROPIC_API_KEY=
API_URL=http://api.railway.internal:3333
RESUME_AGENT_URL=http://resume-agent.railway.internal:8005
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=capsolver
CAPTCHA_SOLVER_ENABLED=false

# === resume-agent ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=${{Postgres.DATABASE_URL}}

# === outreach-agent ===
ANTHROPIC_API_KEY=
API_URL=http://api.railway.internal:3333
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
EMAIL_FROM=
