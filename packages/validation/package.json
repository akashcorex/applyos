{
  "name": "@applyso/validation",
  "version": "0.0.0",
  "private": true,
  "description": "applyso — centralized Zod 4.5 validation contracts shared by web (frontend) and api (backend). Single source of truth for every request/response/form payload in the repo.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./compile": "./src/compile.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "snapshot-json-schema": "bun scripts/snapshot-json-schema.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "express": "^4.21.2"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@applyso/database": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0"
  }
}
