{
  "name": "@applyso/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Postgres schema and Prisma client (Prisma is the only ORM) used by applyso services.",
  "exports": {
    ".": "./src/index.ts",
    "./prisma": "./src/prisma.ts"
  },
  "scripts": {
    "generate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/outreach} prisma generate",
    "migrate": "prisma migrate deploy",
    "push": "prisma db push",
    "studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13"
  }
}
