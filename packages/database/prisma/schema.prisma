generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  role          Role          @default(USER)
  status        AccountStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  banned        Boolean       @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  resumeFiles   ResumeFile[]
  resumes       Resume[]
  resumeVariants ResumeVariant[]
  sourceDocuments ResumeSourceDocument[]
  latexSources  ResumeLatexSource[]
  workflowRuns  WorkflowRun[]
  workflowJobs  WorkflowJob[]
  applications  Application[]
  humanInterventions HumanIntervention[]
  applicationEvents ApplicationEvent[]
  agentTasks    AgentTask[]
  workflowEvents WorkflowEvent[]
  preferences   UserPreferences?
  analyticsEvents AnalyticsEvent[]
  analyticsIdentities AnalyticsIdentity[]
  billingCustomer BillingCustomer?
  subscriptions   Subscription[]
  usageCycles     UsageCycle[]
  savedJobs       SavedJob[]
  notifications   Notification[]
  jobSelections   JobSelection[]

  @@unique([email])
  @@index([role])
  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Profile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String?
  headline            String?
  email               String?
  phone               String?
  location            String?
  professionalSummary String?
  linkedinUrl         String?
  githubUrl           String?
  portfolioUrl        String?
  skills              String[]  @default([])
  education           Json      @default("[]")
  experience          Json      @default("[]")
  projects            Json      @default("[]")
  certifications      Json      @default("[]")
  achievements        Json      @default("[]")
  preferredRoles      String[]  @default([])
  preferredLocations  String[]  @default([])
  workMode            String?
  seniority           String?
  totalExperienceYears Int?
  isConfirmed         Boolean   @default(false)
  confirmedAt         DateTime?
  lastExtractedAt     DateTime?
  extractionVersion   String?
  sourceResumeFileId  String?
  sourceResumeFile    ResumeFile? @relation("ProfileSourceResumeFile", fields: [sourceResumeFileId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("profiles")
}

model ResumeFile {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName          String
  storageKey        String
  mimeType          String
  fileSize          Int
  status            ResumeStatus @default(UPLOADED)
  version           Int          @default(1)
  processedAt       DateTime?
  failedAt          DateTime?
  parserVersion     String?
  extractionVersion String?
  errorCode         String?
  errorMessage      String?
  idempotencyKey    String?
  resumeId          String?      @unique @db.Uuid
  resume            Resume?      @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  sourceProfiles    Profile[]    @relation("ProfileSourceResumeFile")
  extractions       ResumeExtraction[]
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([deletedAt])
  @@unique([userId, idempotencyKey])
  @@map("resume_files")
}

model ResumeExtraction {
  id                String     @id @default(cuid())
  resumeFileId      String
  resumeFile        ResumeFile @relation(fields: [resumeFileId], references: [id], onDelete: Cascade)
  userId            String
  revisionNumber    Int
  schemaVersion     String     @default("resume-extraction.v2")
  parserVersion     String?
  extractionVersion String?
  status            ResumeStatus @default(PROCESSING)
  payload           Json
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime   @default(now())

  @@unique([resumeFileId, revisionNumber])
  @@index([resumeFileId])
  @@index([userId])
  @@map("resume_extractions")
}

model Resume {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                      String   @map("user_id")
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                    String   @map("full_name")
  email                       String
  phone                       String?
  location                    String?
  summary                     String?
  experienceYears             Int      @default(0) @map("experience_years")
  skills                      String[] @default([])
  education                   Json     @default("[]")
  workHistory                 Json     @default("[]") @map("work_history")
  preferredRole               String?  @map("preferred_role")
  preferredLocations          String[] @default([]) @map("preferred_locations")
  rawText                     String?  @map("raw_text")
  fileName                    String?  @map("file_name")
  fileType                    String?  @map("file_type")
  filePath                    String?  @map("file_path")
  profileEmbedding            Json?    @map("profile_embedding") @db.JsonB
  profileTextHash             String?  @map("profile_text_hash")
  profileEmbeddingRevisionId  String?  @map("profile_embedding_revision_id")
  embeddingModel              String?  @map("embedding_model")
  embeddingIndexVersion       String?  @map("embedding_index_version")
  lastMatchIntent             String?  @map("last_match_intent")
  baseProfile                 Json?    @map("base_profile") @db.JsonB
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resumeFile                  ResumeFile?
  variants                    ResumeVariant[]
  sourceDocuments             ResumeSourceDocument[]
  irRevisions                 ResumeIrRevision[]
  patches                     ResumeTailoringPatch[]
  artifacts                   ResumeArtifact[]
  latexSources                ResumeLatexSource[]
  compileJobs                 ResumeCompileJob[]
  variantVersions             VariantVersion[]
  workflowRuns                WorkflowRun[]
  applications                Application[]
  matchSessions               MatchSession[]
  matchInteractions           MatchInteraction[]

  @@index([userId], map: "idx_resumes_user_id")
  @@map("resumes")
}

model ResumeVariant {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId             String    @map("resume_id") @db.Uuid
  resume               Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId               String    @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dedupKey             String    @map("dedup_key")
  jobTitle             String?   @map("job_title")
  companyName          String?   @map("company_name")
  jobDescription       String?   @map("job_description")
  status               String    @default("draft")
  content              Json      @db.JsonB
  suggestions          Json      @default("[]") @db.JsonB
  filePath             String?   @map("file_path")
  sourceRevisionId     String?   @map("source_revision_id")
  patchId              String?   @map("patch_id")
  artifactId           String?   @map("artifact_id")
  baselineMatchScore   Float?    @map("baseline_match_score") @db.Real
  matchScore           Float?    @map("match_score") @db.Real
  matchScoreUpdatedAt  DateTime? @map("match_score_updated_at") @db.Timestamptz(6)
  matchScoreMeta       Json?     @map("match_score_meta") @db.JsonB
  compileGeneration    Int       @default(0) @map("compile_generation")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  patches              ResumeTailoringPatch[]
  artifacts            ResumeArtifact[]
  latexSources         ResumeLatexSource[]
  compileJobs          ResumeCompileJob[]
  versions             VariantVersion[]

  @@index([resumeId], map: "idx_resume_variants_resume_id")
  @@index([userId], map: "idx_resume_variants_user_id")
  @@index([resumeId, dedupKey], map: "idx_resume_variants_dedup")
  @@map("resume_variants")
}

model ResumeSourceDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId      String   @map("resume_id") @db.Uuid
  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String?  @map("file_name")
  fileType      String   @map("file_type")
  storageKey    String   @map("storage_key")
  contentSha256 String   @map("content_sha256")
  byteSize      Int      @map("byte_size")
  parserVersion String   @map("parser_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  irRevisions   ResumeIrRevision[]

  @@index([resumeId], map: "idx_resume_source_documents_resume_id")
  @@index([contentSha256], map: "idx_resume_source_documents_hash")
  @@map("resume_source_documents")
}

model ResumeIrRevision {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId            String                @map("resume_id") @db.Uuid
  resume              Resume                @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  sourceDocumentId    String?               @map("source_document_id") @db.Uuid
  sourceDocument      ResumeSourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  revisionNumber      Int                   @map("revision_number")
  schemaVersion       String                @map("schema_version")
  payload             Json                  @db.JsonB
  sourceDocumentHash  String                @map("source_document_hash")
  extractionModel     String?               @map("extraction_model")
  promptVersion       String?               @map("prompt_version")
  promptHash          String?               @map("prompt_hash")
  validation          Json                  @default("{}") @db.JsonB
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  patches             ResumeTailoringPatch[]
  artifacts           ResumeArtifact[]
  latexSources        ResumeLatexSource[]
  compileJobs         ResumeCompileJob[]

  @@unique([resumeId, revisionNumber])
  @@index([resumeId], map: "idx_resume_ir_revisions_resume_id")
  @@index([sourceDocumentHash], map: "idx_resume_ir_revisions_source_hash")
  @@map("resume_ir_revisions")
}

model ResumeTailoringPatch {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId         String            @map("resume_id") @db.Uuid
  resume           Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  variantId        String?           @map("variant_id") @db.Uuid
  variant          ResumeVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sourceRevisionId String            @map("source_revision_id") @db.Uuid
  sourceRevision   ResumeIrRevision  @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)
  policyVersion    String            @map("policy_version")
  payload          Json              @db.JsonB
  diff             Json              @default("{}") @db.JsonB
  status           String            @default("approved")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  artifacts        ResumeArtifact[]
  compileJobs      ResumeCompileJob[]

  @@index([resumeId], map: "idx_resume_tailoring_patches_resume_id")
  @@index([variantId], map: "idx_resume_tailoring_patches_variant_id")
  @@map("resume_tailoring_patches")
}

model ResumeArtifact {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactHash     String               @unique @map("artifact_hash")
  resumeId         String               @map("resume_id") @db.Uuid
  resume           Resume               @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  variantId        String?              @map("variant_id") @db.Uuid
  variant          ResumeVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sourceRevisionId String               @map("source_revision_id") @db.Uuid
  sourceRevision   ResumeIrRevision     @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)
  patchId          String?              @map("patch_id") @db.Uuid
  patch            ResumeTailoringPatch? @relation(fields: [patchId], references: [id], onDelete: SetNull)
  storageKey       String               @map("storage_key")
  mediaType        String               @default("application/pdf") @map("media_type")
  compilerVersion  String               @map("compiler_version")
  templateVersion  String               @map("template_version")
  pageCount        Int?                 @map("page_count")
  validation       Json                 @default("{}") @db.JsonB
  diff             Json                 @default("{}") @db.JsonB
  provenance       Json                 @default("{}") @db.JsonB
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resumeId], map: "idx_resume_artifacts_resume_id")
  @@index([variantId], map: "idx_resume_artifacts_variant_id")
  @@index([sourceRevisionId], map: "idx_resume_artifacts_source_revision_id")
  @@map("resume_artifacts")
}

model ResumeLatexSource {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId       String            @map("resume_id") @db.Uuid
  resume         Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable by design: user_edit sources may temporarily have no IR
  // linkage. Generated sources must always link to an IR revision.
  irRevisionId   String?           @map("ir_revision_id") @db.Uuid
  sourceRevision ResumeIrRevision? @relation(fields: [irRevisionId], references: [id], onDelete: SetNull)
  variantId      String?           @map("variant_id") @db.Uuid
  variant        ResumeVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  templateId     String            @map("template_id")
  storageKey     String            @map("storage_key")
  sourceHash     String            @map("source_hash")
  origin         String
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resumeId], map: "idx_resume_latex_sources_resume_id")
  @@index([sourceHash], map: "idx_resume_latex_sources_source_hash")
  @@map("resume_latex_sources")
}

model ResumeCompileJob {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId         String         @map("resume_id") @db.Uuid
  resume           Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId           String         @map("user_id")
  variantId        String?        @map("variant_id") @db.Uuid
  variant          ResumeVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  kind             String         @default("preview")
  sourceMode       String         @default("structured") @map("source_mode")
  status           String         @default("queued")
  templateId       String         @map("template_id")
  jobProfile       Json           @map("job_profile") @db.JsonB
  content          Json           @map("content") @db.JsonB
  diff             Json           @default("{}") @map("diff") @db.JsonB
  sourceRevisionId String?        @map("source_revision_id") @db.Uuid
  sourceRevision   ResumeIrRevision? @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)
  patchId          String?        @map("patch_id") @db.Uuid
  patch            ResumeTailoringPatch? @relation(fields: [patchId], references: [id], onDelete: SetNull)
  latexSourceId    String?        @map("latex_source_id") @db.Uuid
  texSource        String?        @map("tex_source")
  texSourceHash    String?        @map("tex_source_hash")
  variantGeneration Int?          @map("variant_generation")
  claimToken       String?        @map("claim_token") @db.Uuid
  artifactHash     String?        @map("artifact_hash")
  attempts         Int            @default(0)
  maxAttempts      Int            @default(3) @map("max_attempts")
  runAfter         DateTime       @default(now()) @map("run_after") @db.Timestamptz(6)
  startedAt        DateTime?      @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?      @map("finished_at") @db.Timestamptz(6)
  lastError        String?        @map("last_error")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([resumeId], map: "idx_resume_compile_jobs_resume_id")
  @@index([variantId], map: "idx_resume_compile_jobs_variant_id")
  @@index([status], map: "idx_resume_compile_jobs_status")
  @@map("resume_compile_jobs")
}

model VariantVersion {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId       String        @map("variant_id") @db.Uuid
  variant         ResumeVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  resumeId        String        @map("resume_id") @db.Uuid
  resume          Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  contentSnapshot Json          @map("content_snapshot") @db.JsonB
  changeReason    String        @default("save") @map("change_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([variantId], map: "idx_variant_versions_variant_id")
  @@map("variant_versions")
}

model WorkflowRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId       String?   @map("resume_id") @db.Uuid
  resume         Resume?   @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status         String    @default("pending")
  idempotencyKey String?   @map("idempotency_key")
  request        Json      @db.JsonB
  errorDetail    String?   @map("error_detail")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobs           WorkflowJob[]
  applications   Application[]
  agentTasks     AgentTask[]
  events         WorkflowEvent[]

  @@unique([userId, idempotencyKey], map: "uq_workflow_runs_user_idempotency_key")
  @@index([userId, createdAt], map: "idx_workflow_runs_user_created_at")
  @@index([userId, status], map: "idx_workflow_runs_user_status")
  @@map("workflow_runs")
}

model WorkflowJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowRunId  String    @map("workflow_run_id") @db.Uuid
  workflowRun    WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String?   @map("job_id")
  job            Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  dedupKey       String    @map("dedup_key")
  externalId     String?   @map("external_id")
  source         String?
  title          String
  companyName    String    @map("company_name")
  department     String?
  location       String?
  locationType   String?   @map("location_type")
  seniority      String?
  applicationUrl String?   @map("application_url")
  descriptionRaw String?   @map("description_raw")
  status         String    @default("discovered")
  matchScore     Float?    @map("match_score") @db.Real
  rankPosition   Int?      @map("rank_position")
  decisionReason String?   @map("decision_reason")
  metadata       Json      @default("{}") @db.JsonB
  discoveredAt   DateTime  @default(now()) @map("discovered_at") @db.Timestamptz(6)
  matchedAt      DateTime? @map("matched_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  applications   Application[]

  @@unique([workflowRunId, dedupKey], map: "uq_workflow_jobs_run_dedup_key")
  @@index([userId, status], map: "idx_workflow_jobs_user_status")
  @@index([workflowRunId, status], map: "idx_workflow_jobs_run_status")
  @@index([externalId], map: "idx_workflow_jobs_external_id")
  @@index([jobId], map: "idx_workflow_jobs_job_id")
  @@map("workflow_jobs")
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  domains     String[] @default([])
  atsType     String?  @map("ats_type")
  atsSlug     String?  @map("ats_slug")
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("companies")
}

model Job {
  id                String         @id @default(cuid())
  dedupKey          String         @unique @map("dedup_key")
  source            String
  externalId        String?        @map("external_id")
  companyName       String         @map("company_name")
  title             String
  titleNormalized   String         @map("title_normalized")
  location          String
  locationNormalized String        @map("location_normalized")
  locationType      String?        @map("location_type")
  seniority         String?
  descriptionRaw    String?        @map("description_raw")
  descriptionHash   String?        @map("description_hash")
  applicationUrl    String?        @map("application_url")
  postedAt          DateTime?      @map("posted_at") @db.Timestamptz(6)
  firstSeenAt       DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt        DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  rawPayload        Json           @default("{}") @map("raw_payload") @db.JsonB
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  savedBy           SavedJob[]
  workflowJobs      WorkflowJob[]
  selectionItems    JobSelectionItem[]

  @@index([companyName], map: "idx_jobs_company_name")
  @@index([isActive, lastSeenAt], map: "idx_jobs_active_last_seen")
  @@index([firstSeenAt], map: "idx_jobs_first_seen")
  @@index([titleNormalized], map: "idx_jobs_title_normalized")
  @@map("jobs")
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
