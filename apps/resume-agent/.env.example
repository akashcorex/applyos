HOST=0.0.0.0
PORT=8005

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach
AGENT_SERVICE_TOKEN=
JOB_AGENT_URL=http://127.0.0.1:8002

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# Legacy PGVector (fallback if Chroma not configured)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_COLLECTION_NAME=resumes
RAG_RETRIEVAL_K=4

# --- Chroma Cloud (primary) ---
# Get values from Chroma dashboard: https://www.trychroma.com/<your-org>/<your-region>/<your-db>/sdk?tab=env
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant-id
CHROMA_DATABASE=your-chroma-database
CHROMA_COLLECTION_PREFIX=resumes
CHROMA_SHARD_BY_USER=true
CHROMA_SPARSE_ENABLED=true
CHROMA_DENSE_WEIGHT=0.7
CHROMA_SPARSE_WEIGHT=0.3
CHROMA_RRF_K=60

# Set to tectonic or pdflatex in the compiler worker image.
LATEX_COMPILER=
LATEX_TIMEOUT_SECONDS=15
ALLOW_RENDERER_FALLBACK=true

# Keyword-first tailoring (fast draft = rules only; use POST .../suggest for LLM)
TAILOR_MODE=keyword
TAILOR_LLM_ON_CREATE=false
TAILOR_MAX_SUGGESTIONS=5
