\documentclass[10pt]{article}
\usepackage[margin=0.75in]{geometry}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{xcolor}
\definecolor{applyosaccent}{HTML}{1F4E5F}
\pagestyle{empty}
\setlist[itemize]{leftmargin=1.2em,itemsep=1pt,topsep=2pt}
\titleformat{\section}{\large\bfseries\color{applyosaccent}}{}{0pt}{}[\titlerule]
\begin{document}
{\LARGE\textbf{<< full_name | esc >>}}%
{% if preferred_role %}
\\{\large\textit{<< preferred_role | esc >>}}%
{% endif %}
\\{\small << contact | join('  ·  ') | esc >>}
\vspace{0.4em}
{% if summary %}
\section*{Summary}
<< summary | esc >>
{% endif %}
{% if skills_line %}
\section*{Skills}
<< skills_line | esc >>
{% endif %}
{% if roles %}
\section*{Experience}
{% for role in roles %}
\textbf{<< role.heading | esc >>}\hfill {\small\textit{<< role.dates | esc >>}}\\
\begin{itemize}
{% for bullet in role.highlights %}
\item << bullet | esc >>
{% endfor %}
\end{itemize}
{% endfor %}
{% endif %}
{% if education_lines %}
\section*{Education}
\begin{itemize}
{% for line in education_lines %}
\item << line | esc >>
{% endfor %}
\end{itemize}
{% endif %}
\end{document}
