{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/Dockerfile.web",
    "watchPatterns": [
      "apps/web/**",
      "packages/**",
      "package.json",
      "bun.lock",
      "turbo.json",
      "infra/Dockerfile.web"
    ]
  },
  "deploy": {
    "startCommand": "bun --filter @applyso/web start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
