{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/Dockerfile.web",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/ui/**",
      "/packages/validation/**",
      "/packages/analytics/**",
      "/infra/Dockerfile.web"
    ]
  },
  "deploy": {
    "startCommand": "bun --filter @applyso/web start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
