# Local
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
API_URL=http://localhost:5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach
# Shared with apps/api/.env and agent .env files (server-only; never NEXT_PUBLIC_)
AGENT_SERVICE_TOKEN=
# Google Analytics 4 measurement ID (optional — omit locally to disable gtag)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel production (set in Vercel → Settings → Environment Variables)
# API_URL is required on the server (proxy + /api/auth). Do not rely on NEXT_PUBLIC_* alone.
# NEXT_PUBLIC_API_URL=https://<railway-api>.up.railway.app
# NEXT_PUBLIC_WEB_URL=https://www.applyos.in
# NEXT_PUBLIC_SITE_URL=https://www.applyos.in
# API_URL=https://<railway-api>.up.railway.app
# DATABASE_URL=<same Postgres URL as Railway api>
# AGENT_SERVICE_TOKEN=<same token as Railway>
