NEXT_PUBLIC_API_URL=http://localhost:3333
# Public site origin for the web app (OAuth redirects, etc.)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Optional override for Open Graph / social cards (defaults to NEXT_PUBLIC_WEB_URL).
# In production this must be https://www.applyos.in — never the API host.
# NEXT_PUBLIC_SITE_URL=https://www.applyos.in

# Set to true to show the early-access landing page on /
EARLY_ACCESS_MODE=false

# Absolute path to a local resume PDF/DOCX used for auto-apply when the UI
# does not send resume_url (dev convenience; production should pass a real URL)
DEFAULT_RESUME_PATH=
