# job-agent environment variables
HOST=127.0.0.1
PORT=8002

# Required for embedding-based job ranking
OPENAI_API_KEY=

# Optional: Claude explanations for top-K matches only
ANTHROPIC_API_KEY=

# Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small
EMBED_BATCH_SIZE=96
SEMANTIC_TOP_K=20
EXPLAIN_TOP_K=10

LLM_MODEL=claude-sonnet-4-6
REFRESH_ENABLED=true
REFRESH_INTERVAL_SECONDS=600
REFRESH_BATCH_BOARDS=8
REFRESH_SWEEP_JOBS=50
