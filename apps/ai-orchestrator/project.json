{
  "name": "ai-orchestrator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-orchestrator",
  "projectType": "application",
  "tags": ["type:app", "lang:python"],
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-orchestrator",
        "command": "uv sync --extra dev"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["sync"],
      "options": {
        "cwd": "apps/ai-orchestrator",
        "command": "uv run uvicorn main:app --reload --host 127.0.0.1 --port 8001"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tests/run.py ai-orchestrator",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
