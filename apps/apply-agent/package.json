{
  "name": "apply-agent",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "serve": "sh -c 'python -m uvicorn app.main:app --reload --host 0.0.0.0 --port ${PORT:-8003}'",
    "serve:prod": "sh -c 'python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8003}'",
    "worker": "celery -A app.workers.celery_app worker --loglevel=info --concurrency=2"
  }
}
