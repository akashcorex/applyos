# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude Sonnet 4.6) — dummy, replace with real key in .env
ANTHROPIC_API_KEY=your-anthropic-api-key

# API service (for persisting results)
# Local API is :3333 — macOS AirPlay occupies :5000 and returns 403.
API_URL=http://localhost:3333

# Trusted service authentication for compiled resume artifact downloads
AGENT_SERVICE_TOKEN=
RESUME_AGENT_URL=http://127.0.0.1:8005

# Fallback phone for ATS forms when cv_data.phone is unset (dev/test)
DEFAULT_PHONE=+919876543210

# Fallback LinkedIn profile URL for ATS forms when cv_data.linkedin_url is unset.
# If empty, apply-agent tries the logged-in LinkedIn session (/in/me/).
DEFAULT_LINKEDIN_URL=

# LinkedIn rate limits
LINKEDIN_MAX_CONNECTS_PER_DAY=20
LINKEDIN_MAX_FOLLOWS_PER_DAY=40

# Post-apply: search company employees and send blank connection requests
POST_APPLY_LINKEDIN_CONNECT_ENABLED=true
POST_APPLY_CONNECT_LIMIT=3
POST_APPLY_CONNECT_DELAY_SECONDS=900

# Bootstrap a LinkedIn browser session (headed login → Redis):
#   python scripts/bootstrap_linkedin_session.py --user-id <USER_ID>
# Workers fail with login_required if session:<user_id> is missing/expired.

# CAPTCHA solver — CapSolver (https://dashboard.capsolver.com)
# - Lever: invisible hCaptcha; stealth silent-pass is primary. CapSolver often
#   rejects hCaptcha — prefer APPLY_HEADED=true for Lever.
# - Workable: Cloudflare Turnstile ("Verify you are human"). Checkbox clicks
#   usually fail on Playwright sessions (CF re-checks the whole browser). Use
#   CapSolver AntiTurnstileTaskProxyLess via CAPTCHA_API_KEY.
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=capsolver

# Browser: headed + real Chrome channel. Do not hardcode a stale Chrome UA —
# the engine uses Chrome's native UA when APPLY_USE_CHROME_CHANNEL=true.
APPLY_HEADED=false
APPLY_USE_CHROME_CHANNEL=true
# Match timezone/locale to your IP region (CF compares these).
APPLY_LOCALE=en-IN
APPLY_TIMEZONE=Asia/Kolkata

# Human-in-the-loop: pause on blockers and stream browser to the web UI
HITL_MODE=true
BROWSER_SESSION_TTL_SECONDS=7200
BROWSER_SESSION_HUMAN_WAIT_SECONDS=1800
BROWSER_SESSION_SWEEP_INTERVAL_SECONDS=60

# Server
HOST=127.0.0.1
PORT=8003
