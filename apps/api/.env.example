# Server
HOST=localhost
PORT=5000

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach

# Shared with apps/web/.env.local and agent .env files (server-only)
AGENT_SERVICE_TOKEN=

# resume-agent (used by POST /v1/resumes/upload and /process)
RESUME_AGENT_URL=http://127.0.0.1:8005

# Google OAuth (Better Auth: /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Fallow (optional)
BEACON_API_KEY=
