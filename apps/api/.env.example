# Server
HOST=localhost
PORT=5000

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach

# Shared with apps/web/.env.local and agent .env files (server-only)
AGENT_SERVICE_TOKEN=

# resume-agent (used by POST /v1/resumes/upload and /process)
RESUME_AGENT_URL=http://127.0.0.1:8005

# Google OAuth (Better Auth: /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Fallow (optional)
BEACON_API_KEY=

# Dodo Payments (test mode first — create 9 recurring products + add-on packs)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test
DODO_PRODUCT_STARTER_MONTHLY=pdt_
DODO_PRODUCT_STARTER_QUARTERLY=pdt_
DODO_PRODUCT_STARTER_ANNUAL=pdt_
DODO_PRODUCT_PRO_MONTHLY=pdt_
DODO_PRODUCT_PRO_QUARTERLY=pdt_
DODO_PRODUCT_PRO_ANNUAL=pdt_
DODO_PRODUCT_POWER_MONTHLY=pdt_
DODO_PRODUCT_POWER_QUARTERLY=pdt_
DODO_PRODUCT_POWER_ANNUAL=pdt_
DODO_PRODUCT_ADDON_PLUS_50=pdt_
DODO_PRODUCT_ADDON_PLUS_150=pdt_

# Ops monitoring (optional; leave empty to use code defaults / log-only alerts)
ALERT_WEBHOOK_URL=
OPS_EXPECTED_SERVICES=
OPS_ON_CALL_NAME=
OPS_ALERT_COOLDOWN_MINUTES=
